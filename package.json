{
  "name": "capstone-bible",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:linker": "node scripts/name-linker/run.mjs && node scripts/name-linker/modern-names.mjs --check && node scripts/name-linker/self-name.mjs --check",
    "validate:archaeology": "node scripts/archaeology-validate/run.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#7c3aed' --splashBackgroundColor '#7c3aed'",
    "verify:signed-in": "node scripts/signed-in-harness/run.mjs",
    "test:store-app": "for f in scripts/store-app-tests/*.test.mjs; do node $f || exit 1; done"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "^2.110.8",
    "dompurify": "^3.4.15",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.39.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-easy-crop": "^6.2.3",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
